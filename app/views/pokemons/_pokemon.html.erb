<li>
    <div class="card-container">
        <%= link_to pokemon, class: "card" do %>
            <img src="<%= pokemon.pokemon_image.present? ? url_for(pokemon.pokemon_image) : pokemon.image %>" alt="Image of <%= pokemon.name %>" width="65">
            <div><%= pokemon.name %></div>
        <% end %>
        <div class="card-overlay">
            <p>Type: 
                <% (0..pokemon.types.length - 1).each do |i| %>
                    <%= pokemon.types[i].name.capitalize + (i != pokemon.types.length - 1 ? "," : "") %>
                <% end %>
            </p>
            <p>$<%= pokemon.price %></p>
            <p><%= link_to 'Add to cart', add_to_cart_path(pokemon.id), data: { "turbo-method": :post }, class: "hover" %></p>
        </div>
    </div>
</li>