<div class="home">
  <h2>Edit <%= resource_name.to_s.humanize %></h2>

  <div class="user-info">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, class: "info-title" %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "info" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="field">
        <%= f.label :password, class: "info-title" %> <i>(leave blank if you don't want to change it)</i><br />
        <%= f.password_field :password, autocomplete: "new-password", class: "info" %>
        <% if @minimum_password_length %>
          <br />
          <em><%= @minimum_password_length %> characters minimum</em>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, class: "info-title" %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "info" %>
      </div>

      <div class="field">
        <%= f.label :current_password, class: "info-title" %> <i>(we need your current password to confirm your changes)</i><br />
        <%= f.password_field :current_password, autocomplete: "current-password", class: "info" %>
      </div>

      <div class="name-display">
        <div class="field">
          <%= f.label :first_name, class: "info-title" %><br />
          <%= f.text_field :first_name, class: "info" %>
        </div>

        <div class="field">
          <%= f.label :last_name, class: "info-title" %><br />
          <%= f.text_field :last_name, class: "info" %>
        </div>
      </div>

      <div class="field">
        <%= f.label :street_address, class: "info-title" %><br />
        <%= f.text_field :street_address, class: "info" %>
      </div>

      <div class="field">
        <%= f.label :city, class: "info-title" %><br />
        <%= f.text_field :city, class: "info" %>
      </div>

      <% 
        provinces = []
        Province.all.each do |province|
          provinces << [province.name, province.id]
        end
      %>

      <%= f.label :province_id, class: "info-title" %><br />
      <%= f.select :province_id, provinces, class: "info" %>

      <div class="field">
        <%= f.label :postal_code, class: "info-title" %><br />
        <%= f.text_field :postal_code, class: "info" %>
      </div>

      <div class="actions">
        <%= f.submit "Update", class: "hover" %>
      </div>
    <% end %>

    <a class="return" href=<%= show_user_path %>> &lt&lt Return </a>
  </div>
</div>
