<div class="image-home">
    <%= image_tag asset_path("Pikachu.png"), :id => "pikachu" %>
    <div class="buttons-container">
        <a class="menu-item hover" href=<%= pokemons_path %>>BROWSE</a>
        <a class="menu-item hover" href=<%= about_path %>>ABOUT US</a>
        <% if !user_signed_in? %>
