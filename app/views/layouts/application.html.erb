<!DOCTYPE html>
<html>
  <head>
    <title>PokemonMarket</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Jersey+10&display=swap');
    </style>

    <script src="http://js.stripe.com/v3/"></script>
  </head>

  <body>
  <header>
    <div class="header-container">
      <% unless current_page?(root_path) or current_page?(new_session_path(:user)) or current_page?(new_user_registration_path) %>
        <div></div>
      <% end %>
        <div class="website-name">
          <a href="<%= root_path %>">
            <%= image_tag asset_path("Pokeball.png"), :class => "logo"%>
            <h1>PokéMarket</h1>
          </a>
        </div>
        <% unless current_page?(root_path) or current_page?(new_session_path(:user)) or current_page?(new_user_registration_path) %>
          <nav>
            <%= link_to "BROWSE", pokemons_path, :class => "hover" %>
            <%= link_to "ABOUT US", about_path, :class => "hover" %>
            <% if !user_signed_in? %>
              <%= link_to "LOGIN", new_session_path(:user), :class => "hover" %>
            <% else %>
              <%= link_to current_user.first_name, show_user_path, :class => "hover" %>
            <% end %>
          </nav>
        <%end%>
      </div>  
    </header>

    <%= yield %>
    
    </div>
    <p class="notice"><%= notice %></p><meta name="turbolinks-cache-control" content="no-cache"> 
    <p class="alert"><%= alert %></p>
  </body>
</html>